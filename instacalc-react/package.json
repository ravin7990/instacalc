{
  "name": "instacalc-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "InstaCalc - React + Vite static site with full SEO parity",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:tools && npm run build:client && npm run build:server && npm run build:pages && npm run sitemap",
    "build:client": "vite build --outDir dist",
    "gen:tools": "node scripts/gen-tools.mjs",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:pages": "node scripts/build-pages.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:entities": "node scripts/check-entities.mjs",
    "check:entities:selftest": "node scripts/check-entities.selftest.mjs",
    "check:css": "node scripts/check-css-coverage.mjs",
    "check:css:structure": "node scripts/check-css-structure.mjs",
    "check:css:override": "node scripts/check-css-override.mjs",
    "check:css:selftest": "node scripts/check-css-override.selftest.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:nav:selftest": "node scripts/check-nav.selftest.mjs",
    "check:lang": "node scripts/check-langswitch.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:calc-layout": "node scripts/check-calc-layout.mjs",
    "check:result-dup": "node scripts/check-result-duplication.mjs",
    "check:currency": "node scripts/check-currency.mjs",
    "check:home": "node scripts/check-home.mjs",
    "check:logo": "node scripts/check-logo.mjs",
    "check:seo": "node scripts/check-parity.mjs",
    "check:markup": "node scripts/check-markup.mjs",
    "check:pages": "node scripts/check-new-pages.mjs",
    "check:prose": "node scripts/check-prose.mjs && node scripts/verify-locale-content.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "smoke": "node scripts/smoke-all.mjs",
    "status": "node scripts/migration-status.mjs",
    "inspect:content": "node scripts/extract-content.mjs && node scripts/inspect-content.mjs",
    "extract:seo": "node scripts/extract-seo.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "audit:psi": "node scripts/audit-psi.mjs",
    "verify": "npm run typecheck && npm run check:css:structure && npm run check:css:override && npm run check:css && npm run check:nav && npm run check:entities && npm run test && npm run build && npm run check:calc-layout && npm run check:result-dup && npm run check:currency && npm run check:lang && npm run check:links && npm run check:logo && npm run check:home && npm run check:seo && npm run check:markup && npm run check:prose"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
